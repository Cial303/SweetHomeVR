    "serve": "node scripts/serve.js",
    "shots": "node scripts/screenshots.js",
    "xr-test": "node scripts/xr-test.js"
  },
  "devDependencies": {
    "fflate": "0.8.3",
    "iwer": "2.7.0",
    "playwright": "1.65.1",
    "three": "0.187.0",
    "three-mesh-bvh": "0.9.18"
  }
}
