{
  "name": "sweet-home-vr",
  "version": "0.1.0",
  "private": true,
  "description": "WebXR viewer for Sweet Home 3D files on Meta Quest. Dev tooling only: the app itself has no build step.",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.js",
    "fixtures": "node scripts/fetch-fixtures.js",
    "example": "node scripts/make-example.js",
